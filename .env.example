# Copy this file to `.env` in the project root and fill in your token.
# `.env` is already listed in .gitignore — never commit a real token.
#
# A GitHub Personal Access Token is required ONLY by script
# (03_collect_github_metadata.py). The token raises the API rate limit
# from 60 requests/hour (anonymous) to 5,000 requests/hour (authenticated).
#
# Fine-grained token with read-only public repository access is sufficient:
#   Permissions -> Repository permissions -> Metadata -> Read-only
#
# Classic token with NO scopes is also sufficient (all data collected is public).
# Create one at: https://github.com/settings/tokens

GITHUB_TOKEN=ghp_YOUR_PERSONAL_ACCESS_TOKEN